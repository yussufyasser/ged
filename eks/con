configurationservice/definitions/30e0d5e7-fe43-4e3e-a335-b4a21bd6bc66={"addressByName":false,"addressByTenant":false,"allowUserProperties":false,"createdBy":"sas.svi-sand","creationTimeStamp":1771050413680,"definitionVersion":1,"description":"The set of properties for customizing the analyzers used for searching, filtering and faceting, and sorting in Visual Investigator.","externalRestartRequired":false,"id":"30e0d5e7-fe43-4e3e-a335-b4a21bd6bc66","label":"","modifiedBy":"sas.svi-sand","modifiedTimeStamp":1771050413680,"name":"sas.svi-sand.analysis","properties":[{"addressByName":false,"allowUserProperties":true,"allowUserValue":true,"defaultValue":null,"description":"The name of the search analyzer to use for each locale. The key must be a BCP47 language tag and the value must be a valid analyzer name e.g. \"en\": \"english\". See also \"search\".","label":"","list":false,"name":"analyzersByLocale","properties":null,"required":false,"type":"map","values":null,"valuesSource":"definition"},{"addressByName":false,"allowUserProperties":false,"allowUserValue":true,"defaultValue":"sand_not_analyzed","description":"The name of the analyzer to use for filtering and facets. \"sand_not_analyzed\" is case sensitive. \"sand_icu_facet\" is case insensitive.","label":"","list":false,"name":"facet","properties":null,"required":false,"type":"string","values":null,"valuesSource":"definition"},{"addressByName":false,"allowUserProperties":false,"allowUserValue":false,"defaultValue":"icu_normalizer","description":"The filter to be used when defining the \"sand_icu_search\" analyzer. \"icu_normalizer\" converts the tokens to lowercase and their shortest byte representation. \"icu_folding\" performs character folding in addition to what \"icu_normalizer\" does.","label":"","list":false,"name":"icuFilter","properties":null,"required":false,"type":"string","values":["icu_normalizer","icu_folding"],"valuesSource":"definition"},{"addressByName":false,"allowUserProperties":true,"allowUserVal