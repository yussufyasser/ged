config/cas-shared-default/sas.cas.instance.config/logconfig/contents=<?xml version="1.0" encoding="UTF-8"?>
<logging:configuration xmlns:logging="http://www.sas.com/xml/logging/1.0/">

   <!-- Console Structured Logging -->
   <appender name="Console" class="ConsoleAppender">
      <param name="SkipEmpty" value="true"/>
      <layout type="Json">
        <param name="Individual" value="true"/>
        <param name="version#" value="%S{eventModel.payload.version}"/>
        <param name="timeStamp" value="%d{LEMZone}"/>
        <param name="level" value="%S{eventModel.payload.level}"/>
        <param name="source" value="%S{OSENV.LOG_SOURCE|cas}"/>
        <param name="messageKey" value="%K"/>
        <param name="message" value="%m"/>
        <param name="properties.thread" value="%t"/>
        <param name="properties.caller" value="%F:%L"/>
        <param name="properties.logger" value="%c"/>
        <param name="properties.pod" value="%S{OSENV.LOG_POD_NAME|hostname}"/>
        <param name="properties.appTag" value="%X{Cas.AppTag}"/>
        <param name="properties.nestLevel" value="%X{Cas.NestLevel}"/>
        <param name="properties.sessionIndex" value="%X{Cas.SessionIndex|MAIN}"/>
        <param name="properties.sessionPid" value="%X{Cas.ClientPid|MAIN}"/>
        <param name="properties.sessionUser" value="%X{Cas.ClientUser|NoUser}"/>
        <param name="properties.tenant" value="%S{Cas.TenantID}"/>
      </layout>
   </appender>

   <!-- Unix System Facility Appender, writes to unix system log -->
   <appender class="UNXFacilityAppender" name="UnixSysLog">
      <filter class="RepeatMatchFilter">
      <param name="AcceptOnMatch" value="false"/>
      </filter>
      <layout>
         <param name="ConversionPattern" value="%-5p [%t] %X{Cas.ClientPid|MAIN} %X{Cas.ClientUser|NoUser} %X{Cas.SessionIndex|MAIN} [%F:%L] - %X{Cas.LogStart}%X{Cas.Separator}%m"/>
      </layout>
   </appender>

   <!-- Administration message logger -->
   <logger name="Admin" immutability="true">
      <level value="Info"/>
      <appender-ref ref="UnixSysLog"/>
   </logger>

   <!-- Application message logger -->
   <logger name="App" immutability="true">
      <level value="Info"/>
   </logger>

   <!-- CAS Action message logger -->
   <logger name="App.cas.actions">
      <level value="Info"/>
   </logger>

   <!-- HTTP server access logger -->
   <logger name="App.tk.http.server.access">
      <level value="Error"/>
   </logger>

   <!-- Audit message logger -->
   <logger name="Audit" immutability="true">
      <level value="Info"/>
   </logger>

   <!-- Audit authorization check message logger -->
   <logger name="Audit.Authorization.cas.IsAuth">
      <level value="Info"/>
   </logger>

   <!-- Audit authorization change message logger -->
   <logger name="Audit.Authorization.cas.ACChange">
      <level value="Info"/>
   </logger>

   <!-- Logging Facility logger -->
   <logger name="Logging">
       <level value="Error"/>
       <appender-ref ref="UnixSysLog"/>
   </logger>

   <!-- Performance/Resource logger -->
   <logger name="Perf" immutability="true">
      <level value="Info"/>
   </logger>

   <!-- Session table eventing logger -->
   <logger name="App.cas.table.eventing.session">
      <level value="Info"/>
   </logger>

   <!-- Root logger -->
   <root>
      <level value="Error"/>
      <appender-ref ref="Console"/>
   </root>

</logging:configuration>
config/cas-shared-default/sas.cas.instance.config/sessionlogconfig/contents=<?xml version="1.0" encoding="UTF-8"?>
<logging:configuration xmlns:logging="http://www.sas.com/xml/logging/1.0/">

<!--
Example log4sas configuration to enable debug logging for
  CAS session processes.

Session log files will be written to /tmp in the
  sas-cas-server container.

The environment variable "CAS_SESSION_LOGGING" must
  be set to "true" for this CAS session logging
  configuration to be enabled.
-->

<!-- File logging -->
<appender class="RollingFileAppender" name="ProcessFile">
   <param name="Append" value="false"/>
   <param name="Unique" value="true"/>
   <param name="ImmediateFlush" value="true"/>
   <rollingPolicy class="TimeBasedRollingPolicy">
      <param name="FileNamePattern" value="/tmp/cas_%d_%S{hostname}_%S{pid}.log"/>
   </rollingPolicy>
   <layout>
      <param name="HeaderPattern" value="Process owner: '%S{username}', Host: '%S{hostname}', OS: '%S{os_family}', Release: '%S{os_release}', Command: '%S{startup_cmd}'"/>
      <param name="ConversionPattern" value="%d %-5p [%t] %X{Cas.ClientPid|MAIN} %X{Cas.ClientUser|NoUser} %X{Cas.SessionIndex|MAIN} [%F:%L] - %X{Cas.LogStart}%X{Cas.Separator}%m"/>
   </layout>
</appender>

<!-- Root logger -->
<root>
   <level value="Debug"/>
   <appender-ref ref="ProcessFile"/>
</root>

</logging:configuration>
