configurationservice/configurations/0c89cc65-34c9-4735-86b9-b0a5308f7e69={"id":"0c89cc65-34c9-4735-86b9-b0a5308f7e69","metadata":{"createdBy":"sas-config-761c51ba-e6e7-4486-91d7-1502cbacabf1","creationTimeStamp":1771050269711,"isDefault":true,"mediaType":"application/vnd.sas.configuration.config.sas.cas.instance.config+json;version=1","modifiedBy":"sas-config-761c51ba-e6e7-4486-91d7-1502cbacabf1","modifiedTimeStamp":1771050269711,"services":["cas-shared-default"]},"version":1,"contents":"\u003c?xml version=\"1.0\" encoding=\"UTF-8\"?\u003e\n\u003clogging:configuration xmlns:logging=\"http://www.sas.com/xml/logging/1.0/\"\u003e\n\n\u003c!--\nExample log4sas configuration to enable debug logging for\n  CAS session processes.\n\nSession log files will be written to /tmp in the\n  sas-cas-server container.\n\nThe environment variable \"CAS_SESSION_LOGGING\" must\n  be set to \"true\" for this CAS session logging\n  configuration to be enabled.\n--\u003e\n\n\u003c!-- File logging --\u003e\n\u003cappender class=\"RollingFileAppender\" name=\"ProcessFile\"\u003e\n   \u003cparam name=\"Append\" value=\"false\"/\u003e\n   \u003cparam name=\"Unique\" value=\"true\"/\u003e\n   \u003cparam name=\"ImmediateFlush\" value=\"true\"/\u003e\n   \u003crollingPolicy class=\"TimeBasedRollingPolicy\"\u003e\n      \u003cparam name=\"FileNamePattern\" value=\"/tmp/cas_%d_%S{hostname}_%S{pid}.log\"/\u003e\n   \u003c/rollingPolicy\u003e\n   \u003clayout\u003e\n      \u003cparam name=\"HeaderPattern\" value=\"Process owner: '%S{username}', Host: '%S{hostname}', OS: '%S{os_family}', Release: '%S{os_release}', Command: '%S{startup_cmd}'\"/\u003e\n      \u003cparam name=\"ConversionPattern\" value=\"%d %-5p [%t] %X{Cas.ClientPid|MAIN} %X{Cas.ClientUser|NoUser} %X{Cas.SessionIndex|MAIN} [%F:%L] - %X{Cas.LogStart}%X{Cas.Separator}%m\"/\u003e\n   \u003c/layout\u003e\n\u003c/appender\u003e\n\n\u003c!-- Root logger --\u003e\n\u003croot\u003e\n   \u003clevel value=\"Debug\"/\u003e\n   \u003cappender-ref ref=\"ProcessFile\"/\u003e\n\u003c/root\u003e\n\n\u003c/logging:configuration\u003e","name":"sessionlogconfig"}
