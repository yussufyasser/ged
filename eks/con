configurationservice/definitions/26519022-ce67-4387-9458-de0d322f62a7={"addressByName":false,"addressByTenant":true,"allowUserProperties":false,"createdBy":"sas.identities","creationTimeStamp":1771050205657,"definitionVersion":1,"externalRestartRequired":false,"id":"26519022-ce67-4387-9458-de0d322f62a7","label":"","modifiedBy":"sas.identities","modifiedTimeStamp":1771050205657,"name":"sas.identities.providers.ldap.connection","properties":[{"addressByName":false,"allowUserProperties":false,"allowUserValue":true,"defaultValue":null,"description":"The host name of the LDAP server to connect to.","label":"","list":false,"name":"host","properties":null,"required":true,"type":"string","values":null,"valuesSource":"definition"},{"addressByName":false,"allowUserProperties":false,"allowUserValue":true,"defaultValue":null,"description":"The password for logging on to the LDAP server.","label":"","list":false,"name":"password","properties":null,"required":true,"type":"string","values":null,"valuesSource":"definition"},{"addressByName":false,"allowUserProperties":false,"allowUserValue":true,"defaultValue":true,"description":"Enables pooling of LDAP connections.","label":"","list":false,"name":"pool.enabled","properties":null,"required":true,"type":"boolean","values":null,"valuesSource":"definition"},{"addressByName":false,"allowUserProperties":false,"allowUserValue":true,"defaultValue":240000,"description":"The number of milliseconds that the idle-object evictor thread sleeps between runs. If the value is non-positive, the idle object evictor thread does not run.","label":"","list":false,"name":"pool.evictionTimePeriodMillis","properties":null,"required":false,"type":"integer","values":null,"valuesSource":"definition"},{"addressByName":false,"allowUserProperties":false,"allowUserValue":true,"defaultValue":480000,"description":"The minimum amount of time in milliseconds that objects can sit idle in the pool before becoming eligible for eviction by the idle-object evictor, if pr